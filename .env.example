# Existing directory in a HexOS dataset; use the actual path on your NAS.
DATA_PATH=/mnt/your-pool/app-data/blocket-tracker
# UID/GID with write access to that directory. Default container user: 10001.
PUID=10001
PGID=10001
PORT=8080
MAX_PAGES=50
# Limit detail requests per saved search per refresh; summaries are still collected.
DETAIL_LIMIT=100
REQUEST_DELAY=0.5
GEOCODING=true
GEOCODER_URL=https://nominatim.openstreetmap.org/search
# Identify your personal installation; adding a contact address is encouraged.
GEOCODER_USER_AGENT=BlocketTracker/1.0 personal NAS car tracker

# External Ollama installed on your Mac, reached from Docker Desktop.
# On the NAS, replace LLM_URL with the reachable Ollama server IP and port.
LLM_ENABLED=true
LLM_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:1.7b
LLM_TIMEOUT=180
LLM_THREADS=2
